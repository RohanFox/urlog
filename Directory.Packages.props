<Project>
  <!-- Central package pins. Bump here, never in a csproj. -->
  <ItemGroup>
    <PackageVersion Include="ClickHouse.Driver" Version="1.5.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="4.16.0" />
    <!-- Chunk pipeline: decompression inside the chunk pipeline (gzip is in the BCL). -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="SharpCompress" Version="0.50.8" />
    <!-- Field catalog (src/Query/field-catalog.yaml). -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <!-- [LogSource] registry source generator (netstandard2.0 component, loaded by the SDK's Roslyn). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Metadata store (src/Core/Metadata): EF Core on SQLite; Design is for `dotnet ef` only (PrivateAssets=all);
         the Npgsql provider is test-only, for the Postgres-portability test in tests/Metadata.Tests. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Local accounts (src/Core/Auth): managed Argon2id, no native artifact; the test host for tests/Api.Tests. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Debug logging in the chunk pipeline (src/Core/Pipeline); the same version EF Core brings in. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
</Project>
