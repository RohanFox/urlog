root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.{json,yml,yaml,xml,md,ps1,sh}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# EF Core migrations are generated by `dotnet ef migrations add` (src/Core/Metadata/DesignTimeFactory.cs) and are not
# hand-written: the analyzers treat them as generated code (CA1861 on the index column arrays, IDE0161 on the namespace
# form the tool emits). Nothing else under src/ is exempt.
[src/Core/Metadata/Migrations/*.cs]
generated_code = true
