<Project Sdk="Microsoft.NET.Sdk">
  <!-- Needs Docker (Testcontainers). Runs from tools/pre-merge.ps1, never from the pre-commit hook. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CHTCP0001: ClickHouse.Driver marks its native TCP client experimental. We use it on purpose; the
         decision and the fallback are recorded in docs/adr/0002-clickhouse-driver.md. -->
    <NoWarn>$(NoWarn);CHTCP0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="ClickHouse.Driver" />
    <PackageReference Include="Testcontainers.ClickHouse" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <ProjectReference Include="../../src/Sources/Sources.csproj" />
    <!-- The fixed-seed 1 GiB fixture (generated on first use) for the worker tests. -->
    <ProjectReference Include="../../bench/Bench.csproj" />
    <!-- Built before these tests, not referenced: the crash tests start urlog as a child process. -->
    <ProjectReference Include="../../src/Cli/Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
