<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the harness itself: fixture determinism, distributions, stub tokeniser. No Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CHTCP0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../bench/Bench.csproj" />
  </ItemGroup>
</Project>
