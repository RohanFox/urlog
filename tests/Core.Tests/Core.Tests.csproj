<Project Sdk="Microsoft.NET.Sdk">
  <!-- xunit v3 test projects are executables run by Microsoft.Testing.Platform (see global.json "test"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Urlog.Tests.Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The allocation measurement every zero-allocation test uses. -->
    <Compile Include="../Shared/AllocationProbe.cs" Link="Shared/AllocationProbe.cs" />
    <!-- A row-for-row dump of a metadata file: how the store identity tests assert that nothing was written. -->
    <Compile Include="../Shared/MetadataDump.cs" Link="Shared/MetadataDump.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fixture corpus's own xz, tar and zip encoders: the decoder tests need whole and cut files of every format. -->
    <Compile Include="../Sources.Tests/Detection/FixtureContainers.cs" Link="Shared/FixtureContainers.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <!-- Built before these tests, not referenced: the runner lock test starts urlog as a child process. -->
    <ProjectReference Include="../../src/Cli/Cli.csproj" ReferenceOutputAssembly="false" />
    <!-- The registry generator runs over this assembly too, so the generated registry can be tested against a test source. -->
    <ProjectReference Include="../../src/Core.SourceGen/Core.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
