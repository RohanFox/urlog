{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:5080" }
    }
  },
  "Urlog": {
    "Metadata": { "Path": "data/metadata.db" },
    "Auth": {
      "IdleTimeout": "08:00:00",
      "AbsoluteTimeout": "1.00:00:00",
      "SessionTouchInterval": "00:05:00",
      "LockoutThreshold": 10,
      "LockoutDuration": "00:15:00",
      "MaxConcurrentHashes": 4,
      "LoginThrottle": { "Attempts": 5, "Window": "00:01:00" }
    },
    "Http": {
      "TrustedProxies": []
    },
    "Upload": {
      "MaxFileBytes": 21474836480,
      "Expiry": "1.00:00:00",
      "SweepInterval": "00:15:00",
      "HandOverBusyTimeout": "00:01:00",
      "HandOverRetry": "00:00:05"
    },
    "ClickHouse": {
      "Host": "127.0.0.1",
      "NativePort": 9000,
      "HttpPort": 8123
    },
    "Ingest": {
      "Enabled": true,
      "MaxConcurrentJobs": 1,
      "Parallelism": 0,
      "Writers": 4,
      "SmallBox": false,
      "EvidenceRoot": "data/intake",
      "ProgressInterval": "00:00:02",
      "Watermark": { "MinFreeBytes": 21474836480, "MinFreePercent": 10, "Paths": [] },
      "NightlyBackupAtUtc": "02:00:00",
      "BackupDirectory": "",
      "Stats": { "Enabled": true, "QuietPeriod": "00:00:15", "TimeLimit": "00:10:00", "MaxThreads": 4, "MaxMemoryBytes": 1000000000, "MaxCaseRows": 2500000000 }
    },
    "Query": { "PageSize": 200, "MaxPagedRows": 10000, "MaxTableRows": 10000, "MaxExportRows": 1000000, "MaxQueryLength": 8000, "UserSlots": 4, "TotalSlots": 12, "SlotWait": "00:00:01" },
    "Lifecycle": {
      "TwoPersonPurge": false,
      "PurgeAfter": "7.00:00:00",
      "ScheduledPurge": true,
      "SweepAtUtc": "03:00:00",
      "ArchiveRoot": ""
    }
  }
}
