    "expect": {
      "sql": "SELECT extractGroups(message, {p1:String})[1] AS `c0`, extractGroups(message, {p1:String})[2] AS `c1`, count() AS `c2` FROM events_v WHERE case_id = {case:UInt64} AND ts >= {from:DateTime64(3)} AND ts < {to:DateTime64(3)} AND (program = {p0:String}) AND notEmpty(extractGroups(message, {p1:String})[1]) AND notEmpty(extractGroups(message, {p1:String})[2]) GROUP BY extractGroups(message, {p1:String})[1], extractGroups(message, {p1:String})[2] ORDER BY `c2` DESC LIMIT {limit:UInt64}",
      "params": {
        "case": "UInt64:1",
        "from": "DateTime64(3):2026-03-01 00:00:00.000",
        "to": "DateTime64(3):2026-04-01 00:00:00.000",
        "p0": "String:sshd",
        "p1": "String:for (?<target>\\S+) from (?<peer>\\S+)",
        "limit": "UInt64:20"
      },
      "warnings": [],
      "fields": [
        "program",
        "message"
      ],
