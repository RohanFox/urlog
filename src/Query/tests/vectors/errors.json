  {
    "name": "verb-table",
    "spl": "host=a | table host",
    "expect": {
      "sql": "SELECT host AS `host.name` FROM events_v WHERE case_id = {case:UInt64} AND ts >= {from:DateTime64(3)} AND ts < {to:DateTime64(3)} AND (host = {p0:String}) ORDER BY ts DESC LIMIT {limit:UInt64}",
      "params": {
        "case": "UInt64:1",
        "from": "DateTime64(3):2026-03-01 00:00:00.000",
        "to": "DateTime64(3):2026-04-01 00:00:00.000",
        "p0": "String:a",
        "limit": "UInt64:100"
      },
      "warnings": [],
      "fields": [
        "host.name"
      ],
      "aggregate": false,
      "columns": [
        "host.name"
      ]
    }
  },
  {
    "name": "verb-rex",
    "spl": "| rex field=raw \"(?P<x>.*)\"",
    "expect": {
      "sql": "SELECT ts, host, program, severity, source_ip, message, extractGroups(raw, {p0:String})[1] AS `c0` FROM events_v WHERE case_id = {case:UInt64} AND ts >= {from:DateTime64(3)} AND ts < {to:DateTime64(3)} ORDER BY ts DESC LIMIT {limit:UInt64}",
      "params": {
        "case": "UInt64:1",
        "from": "DateTime64(3):2026-03-01 00:00:00.000",
        "to": "DateTime64(3):2026-04-01 00:00:00.000",
        "p0": "String:(?P<x>.*)",
        "limit": "UInt64:100"
      },
      "warnings": [],
      "fields": [
        "raw"
      ],
      "aggregate": false,
      "columns": [
        "ts",
        "host",
        "program",
        "severity",
        "source_ip",
        "message",
        "x"
      ]
    }
  },
  {
    "name": "verb-timechart",
    "spl": "| timechart span=1h count",
    "expect": {
      "sql": "SELECT toStartOfInterval(ts, toIntervalHour({span:UInt32})) AS `_time`, count() AS `c0` FROM events_v WHERE case_id = {case:UInt64} AND ts >= {from:DateTime64(3)} AND ts < {to:DateTime64(3)} GROUP BY `_time` ORDER BY `_time` ASC",
      "params": {
        "case": "UInt64:1",
        "from": "DateTime64(3):2026-03-01 00:00:00.000",
        "to": "DateTime64(3):2026-04-01 00:00:00.000",
        "span": "UInt32:1"
      },
      "warnings": [],
      "fields": [],
      "aggregate": true,
      "columns": [
        "_time",
        "count"
      ]
    }
